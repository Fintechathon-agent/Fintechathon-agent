{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fintechathon-agent.github.io/contracts/model-review.v1.schema.json",
  "title": "Personal AI Fund Manager model review and Risk workflow",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/ReviewRequest" },
    { "$ref": "#/$defs/WorkflowRecord" },
    { "$ref": "#/$defs/RiskDecisionRequest" },
    { "$ref": "#/$defs/ApprovalRequest" },
    { "$ref": "#/$defs/SimulationRequest" },
    { "$ref": "#/$defs/CancellationRequest" }
  ],
  "$defs": {
    "DecisionText": {
      "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S",
      "description": "Non-empty label/reason, trimmed by the server. Never silently truncated. Actor labels are not authenticated identities."
    },
    "ReviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "schema_version": { "const": "model-review.v1" },
        "request_id": { "type": ["string", "null"] },
        "task_id": { "type": ["string", "null"] },
        "session_id": { "type": ["string", "null"] },
        "source_task_id": { "type": ["string", "null"] },
        "kind": { "type": "string", "enum": ["bill", "news", "combined"] },
        "scenario": { "type": "string", "enum": ["GENERAL_REVIEW", "FUNDING_CONFLICT", "DOUBLE11_COMPARE", "SUBSCRIPTION_REVIEW"] },
        "source": { "type": ["string", "null"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "requested_action": { "type": ["string", "null"] },
        "action_parameters": { "type": "object" },
        "context": { "type": "object" },
        "allow_rule_fallback": { "type": "boolean" },
        "data_mode": { "type": "string", "enum": ["FIXTURE", "LIVE", "SYNTHETIC_REPLAY", "REFERENCE_FIXTURE"] },
        "execution_mode": { "const": "PAPER" },
        "capability": { "type": "string", "enum": ["REVIEW_ONLY", "SIMULATION_ONLY"] },
        "portfolio_snapshot_id": { "type": ["string", "null"] },
        "risk_profile_version": { "type": ["string", "null"] },
        "plan_id": { "type": ["string", "null"] },
        "plan_hash": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
        "policy_version": { "type": ["string", "null"] },
        "idempotency_key": { "type": ["string", "null"] },
        "memory_consent": { "type": "boolean" }
        ,"output_formats": { "type": "array", "items": { "enum": ["json", "pdf", "pptx", "docx", "xlsx", "chart"] }, "minItems": 1, "uniqueItems": true }
      }
    },
    "WorkflowRecord": {
      "type": "object",
      "required": ["workflow_version", "task_id", "request_id", "run_id", "status", "model", "proposed_action", "risk_handoff", "risk_decision", "approval", "execution", "audit"],
      "properties": {
        "workflow_version": { "const": "review-workflow.v1" },
        "schema_version": { "const": "model-review.v1" },
        "task_id": { "type": "string" },
        "request_id": { "type": "string" },
        "run_id": { "type": "string" },
        "session_id": { "type": ["string", "null"] },
        "source_task_id": { "type": ["string", "null"] },
        "scenario": { "type": "string", "enum": ["GENERAL_REVIEW", "FUNDING_CONFLICT", "DOUBLE11_COMPARE", "SUBSCRIPTION_REVIEW"] },
        "data_mode": { "type": "string" },
        "execution_mode": { "const": "PAPER" },
        "capability": { "type": "string" },
        "portfolio_snapshot_id": { "type": ["string", "null"] },
        "risk_profile_version": { "type": ["string", "null"] },
        "plan_id": { "type": ["string", "null"] },
        "plan_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "policy_version": { "type": ["string", "null"] },
        "idempotency_key": { "type": ["string", "null"] },
        "output_contract": { "$ref": "agent-output.v1.schema.json#/$defs/OutputContract" },
        "memory_consent": { "type": "boolean" },
        "memory_write_status": { "type": "string", "enum": ["NOT_REQUESTED", "PENDING", "WRITTEN", "UNAVAILABLE", "FAILED"] },
        "status": { "type": "string", "enum": ["PENDING_RISK", "PENDING_APPROVAL", "READY_FOR_SIMULATION", "SIMULATED", "REJECTED", "EXPIRED", "MODEL_FAILED", "FUNDING_BLOCKED", "CANCELLED"] },
        "model": {
          "type": "object",
          "properties": {
            "response": {
              "type": ["object", "null"],
              "properties": {
                "attempt_count": { "type": "integer", "minimum": 1, "maximum": 3 },
                "retry_count": { "type": "integer", "minimum": 0, "maximum": 2 }
              }
            },
            "model_response": {
              "type": "object",
              "properties": {
                "attempt_count": { "type": "integer", "minimum": 1 },
                "retry_count": { "type": "integer", "minimum": 0 },
                "data_mode": { "type": "string" },
                "execution_mode": { "const": "PAPER" },
                "capability": { "type": "string" }
              }
            }
          }
        },
        "proposed_action": { "anyOf": [{ "$ref": "#/$defs/ProposedAction" }, { "type": "null" }] },
        "risk_handoff": { "$ref": "#/$defs/RiskHandoff" },
        "risk_decision": { "type": ["object", "null"] },
        "risk_dispatch": { "$ref": "owner-bridge.v1.schema.json#/$defs/RiskDispatchState" },
        "approval": { "$ref": "#/$defs/ApprovalState" },
        "execution": { "$ref": "#/$defs/ExecutionState" },
        "audit": { "$ref": "#/$defs/Audit" },
        "error": { "type": "object" }
      }
    },
    "ProposedAction": {
      "type": "object",
      "required": ["proposed_action", "action_reason", "risk_level", "action_parameters", "proposal_sha256"],
      "properties": {
        "proposed_action": { "type": ["string", "null"], "enum": ["NO_ACTION", "REQUEST_MORE_INFO", "HOLD_FOR_REVIEW", "FLAG_FOR_RISK", null] },
        "action_reason": { "type": ["string", "null"] },
        "risk_level": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
        "requested_action": { "type": ["string", "null"] },
        "action_parameters": { "type": "object" },
        "model_response_id": { "type": ["string", "null"] },
        "funding": { "$ref": "https://fintechathon-agent.github.io/contracts/funding-plan-demo.v1.schema.json#/$defs/Binding" },
        "proposal_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "RiskHandoff": {
      "type": "object",
      "required": ["contract_version", "handoff_id", "task_id", "run_id", "status", "decision", "owner", "evidence", "execution_allowed"],
      "properties": {
        "contract_version": { "const": "model-review.v1" },
        "handoff_id": { "type": "string" },
        "task_id": { "type": "string" },
        "run_id": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING_REVIEW", "APPROVED", "REJECTED", "BLOCKED"] },
        "decision": { "type": "string" },
        "owner": { "type": "string" },
        "reason": { "type": "string" },
        "evidence": { "type": "object" },
        "execution_allowed": { "const": false }
      }
    },
    "ApprovalState": {
      "type": "object",
      "required": ["approval_id", "task_id", "required", "status", "proposal_sha256", "expires_at"],
      "properties": {
        "approval_id": { "type": "string" },
        "task_id": { "type": "string" },
        "required": { "type": "boolean" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED", "BLOCKED", "NOT_REQUIRED"] },
        "decision": { "type": ["string", "null"] },
        "proposal_sha256": { "type": ["string", "null"] },
        "approver": { "type": ["string", "null"] },
        "decided_at": { "type": ["string", "null"] },
        "auth": { "$ref": "owner-bridge.v1.schema.json#/$defs/ActorAuth" }
        ,"expires_at": { "type": ["string", "null"] }
      }
    },
    "ExecutionState": {
      "type": "object",
      "required": ["task_id", "status", "simulation_allowed", "execution_allowed"],
      "properties": {
        "execution_id": { "type": ["string", "null"] },
        "task_id": { "type": "string" },
        "status": { "type": "string", "enum": ["BLOCKED", "READY", "SIMULATED"] },
        "simulation_allowed": { "type": "boolean" },
        "execution_allowed": { "const": false },
        "receipt": { "type": ["object", "null"] }
      }
    },
    "Audit": {
      "type": "object",
      "required": ["audit_id", "workflow_version", "task_id", "request_id", "run_id", "events"],
      "properties": {
        "audit_id": { "type": "string" },
        "workflow_version": { "const": "review-workflow.v1" },
        "task_id": { "type": "string" },
        "request_id": { "type": "string" },
        "run_id": { "type": "string" },
        "events": { "type": "array", "items": { "type": "object", "required": ["event_id", "task_id", "actor", "event_type", "payload", "timestamp"] } }
      }
    },
    "RiskDecisionRequest": {
      "type": "object",
      "description": "For a nonterminal task, a retry must match decision, reviewer, reason and proposal hash after normalization. Changed evidence returns 409 and is audited. Terminal tasks still reject new decisions.",
      "additionalProperties": false,
      "required": ["task_id", "proposal_sha256", "decision", "reviewer", "reason"],
      "properties": {
        "task_id": { "type": "string" },
        "proposal_sha256": { "type": "string" },
        "decision": { "type": "string", "enum": ["APPROVE", "REJECT", "REQUEST_MORE_INFO"] },
        "reviewer": { "$ref": "#/$defs/DecisionText" },
        "reason": { "$ref": "#/$defs/DecisionText" }
      }
    },
    "ApprovalRequest": {
      "type": "object",
      "description": "A retry must match decision, approver, reason and proposal hash after normalization. Identical nonterminal retries return the existing record; changed evidence returns 409. Invalid labels/reasons return 422.",
      "additionalProperties": false,
      "required": ["task_id", "proposal_sha256", "decision", "approver", "reason"],
      "properties": {
        "task_id": { "type": "string" },
        "proposal_sha256": { "type": "string" },
        "decision": { "type": "string", "enum": ["APPROVE", "REJECT"] },
        "approver": { "$ref": "#/$defs/DecisionText" },
        "reason": { "$ref": "#/$defs/DecisionText" }
      }
    },
    "SimulationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "proposal_sha256"],
      "properties": {
        "task_id": { "type": "string" },
        "proposal_sha256": { "type": "string" }
      }
    },
    "CancellationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "proposal_sha256", "canceler", "reason"],
      "properties": {
        "task_id": { "type": "string" },
        "proposal_sha256": { "type": "string" },
        "canceler": { "$ref": "#/$defs/DecisionText" },
        "reason": { "$ref": "#/$defs/DecisionText" }
      }
    }
  }
}
