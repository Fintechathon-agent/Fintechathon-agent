{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fintechathon-agent.github.io/contracts/funding-plan-demo.v1.schema.json",
  "title": "Synthetic funding plan — not trusted Memory or independent Risk",
  "oneOf": [
    {
      "$ref": "#/$defs/CreateRequest"
    },
    {
      "$ref": "#/$defs/ReviseRequest"
    },
    {
      "$ref": "#/$defs/PlanResponse"
    }
  ],
  "$defs": {
    "Purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose_id",
        "label",
        "amount_minor"
      ],
      "properties": {
        "purpose_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      }
    },
    "CreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "confirmed",
        "currency",
        "cash_minor",
        "protected_purposes"
      ],
      "properties": {
        "synthetic": {
          "const": true
        },
        "confirmed": {
          "const": true
        },
        "currency": {
          "const": "CNY"
        },
        "cash_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "protected_purposes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/Purpose"
          }
        }
      }
    },
    "ReviseRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "confirmed",
        "currency",
        "cash_minor",
        "protected_purposes",
        "plan_id",
        "expected_revision"
      ],
      "properties": {
        "synthetic": {
          "const": true
        },
        "confirmed": {
          "const": true
        },
        "currency": {
          "const": "CNY"
        },
        "cash_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "protected_purposes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/Purpose"
          }
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guard_version",
        "plan_id",
        "revision",
        "amount_minor",
        "currency",
        "authority",
        "cash_minor",
        "protected_purposes"
      ],
      "properties": {
        "guard_version": {
          "const": "funding-plan-demo.v1"
        },
        "plan_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "currency": {
          "const": "CNY"
        },
        "authority": {
          "const": "DEMO_USER_CONFIRMED_NOT_TRUSTED_MEMORY"
        },
        "cash_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "protected_purposes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/Purpose"
          }
        }
      }
    },
    "PlanResponse": {
      "type": "object",
      "required": [
        "plan_version",
        "plan_id",
        "revision",
        "authority",
        "synthetic",
        "currency",
        "cash_minor",
        "protected_purposes",
        "allocations",
        "revisions",
        "protected_minor",
        "allocated_minor",
        "available_minor",
        "deficit_minor",
        "execution_allowed"
      ],
      "properties": {
        "plan_version": {
          "const": "funding-plan-demo.v1"
        },
        "plan_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "authority": {
          "const": "DEMO_USER_CONFIRMED_NOT_TRUSTED_MEMORY"
        },
        "synthetic": {
          "const": true
        },
        "currency": {
          "const": "CNY"
        },
        "cash_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "protected_purposes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/Purpose"
          }
        },
        "allocations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Allocation"
          }
        },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "revision",
              "cash_minor",
              "protected_purposes",
              "confirmed_at"
            ]
          }
        },
        "protected_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "allocated_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "available_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "deficit_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "execution_allowed": {
          "const": false
        }
      }
    },
    "Allocation": {
      "type": "object",
      "required": [
        "allocation_id",
        "task_id",
        "proposal_sha256",
        "execution_id",
        "revision",
        "amount_minor",
        "created_at",
        "mode",
        "side_effects"
      ],
      "properties": {
        "allocation_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "proposal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "execution_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "created_at": {
          "type": "string"
        },
        "mode": {
          "const": "SIMULATED"
        },
        "side_effects": {
          "const": false
        }
      }
    }
  }
}
